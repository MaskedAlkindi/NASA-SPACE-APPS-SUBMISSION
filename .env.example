# ---------------------------------------------------------------------------
# HEALTH-01 configuration. Copy to .env:  cp .env.example .env
# Everything works with these defaults; the OpenAI key is OPTIONAL.
# ---------------------------------------------------------------------------

# Ports on your machine
WEB_PORT=8080
API_PORT=8000

# Database (container-internal; not exposed to the host)
POSTGRES_DB=hmt
POSTGRES_USER=hmt
POSTGRES_PASSWORD=hmt-local-only

# Auth. Set a long random SECRET_KEY to keep login tokens valid across restarts.
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=24
# Demo mode seeds a simulated crew + history and shows demo accounts on the login page.
DEMO_MODE=true
DEMO_PASSCODE=hmt-demo
SEED_DAYS=45
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# NASA OSDR (public, no key needed). Set NASA_ONLINE=false for a fully offline demo
# (uses the bundled snapshot in data/nasa_snapshot).
NASA_ONLINE=true
NASA_TIMEOUT_S=20

# Assistant provider: auto | openai | ollama | offline
#   auto = OpenAI if OPENAI_API_KEY is set, otherwise a local Ollama model if one is running,
#          otherwise the deterministic offline explainer. Users can also pick a provider/model
#          per chat on the website, and mission control can save a new default there.
ASSISTANT_PROVIDER=auto

# Local models via Ollama (optional, https://ollama.com). Install a chat model, e.g. `ollama pull qwen2.5:7b`.
# Inside Docker the API reaches the host's Ollama at host.docker.internal (set in docker-compose.yml);
# OLLAMA_BASE_URL is used when running the backend directly on your machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# Blank = first installed chat model (embedding-only models are skipped automatically)
OLLAMA_MODEL=
OLLAMA_TIMEOUT_S=180
OLLAMA_NUM_CTX=8192

# OpenAI assistant (optional).
OPENAI_API_KEY=
# Models offered in the website's model picker (the default OPENAI_MODEL is always included)
OPENAI_MODEL_OPTIONS=gpt-5-mini,gpt-5-nano,gpt-4.1-mini
OPENAI_MODEL=gpt-5-mini
# Sent only to reasoning models (gpt-5*, o*). Leave blank to omit.
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_TIMEOUT_S=25
ASSISTANT_HISTORY_LIMIT=6
ASSISTANT_MAX_PASSAGES=3
ASSISTANT_RATE_LIMIT_PER_MINUTE=6
# Daily caps across all users (0 = unlimited)
ASSISTANT_DAILY_REQUEST_BUDGET=200
ASSISTANT_DAILY_TOKEN_BUDGET=200000

# Simulator speed: real seconds per simulated hour
SIM_TICK_SECONDS=1.5

# Comma-separated module IDs to disable (e.g. android_health,nasa_osdr)
HMT_DISABLED_MODULES=

# Exercise module. Leave the URLs empty to keep recommendations on the built-in rules
# engine and rep counting in the browser. Camera frames are never sent unless
# EXERCISE_ALLOW_REMOTE_FRAMES=true and the user consents in the UI.
EXERCISE_INFERENCE_URL=
EXERCISE_INFERENCE_TOKEN=
EXERCISE_ALLOW_REMOTE_FRAMES=false
EXERCISE_RECOMMENDER_URL=
EXERCISE_RECOMMENDER_TOKEN=
# EXERCISE_POSE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm
# EXERCISE_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task
